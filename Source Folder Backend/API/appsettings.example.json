{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Constr": "Data Source=SERVER;Initial Catalog=DATABASE;User ID=USER;Password=PASSWORD<user>;Password=<password>;Encrypt=False;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Key": "<jwt-signing-key, 32+ characters>",
    "Issuer": "youtCompanyIssuer.com",
    "Audience": "youtCompanyAudience.com"
  }
}
