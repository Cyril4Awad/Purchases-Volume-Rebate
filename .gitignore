# Only the SuperStore Volume Rebate project is versioned; the ERP reference copies
# (old frontend/backend, Sales Volume Rebate*, Design System, loose notes) stay local.
/*
!/.gitignore
!/README.md
!/Source Folder Backend/
!/Source Folder Frontend/
!/SQL Scripts/

# ---------- secrets: real configs stay local, appsettings.example.json is committed ----------
appsettings.json
appsettings.*.json
!appsettings.example.json

# ---------- .NET ----------
bin/
obj/
.vs/
*.user
*.suo
*.pubxml.user
# runtime upload folders written by the API
/Source Folder Backend/*/assets/Job-*/

# ---------- frontend ----------
node_modules/
/Source Folder Frontend/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env*
!.env.example

# ---------- OS / editors ----------
Thumbs.db
.DS_Store
.idea/
